{
  "swagger": "2.0",
  "info": {
    "title": "Modular App API",
    "description": "API for a modular Go application with authentication",
    "version": "1.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": ["http"],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter the token with the `Bearer ` prefix, e.g. \"Bearer abcde12345\"."
    }
  },
  "paths": {
    "/api/v1/items": {
      "get": {
        "summary": "Get all items",
        "description": "Retrieves a list of all items",
        "tags": ["items"],
        "security": [{"Bearer": []}],
        "responses": {
          "200": {
            "description": "A list of items",
            "schema": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Item"
                  }
                },
                "user": {
                  "$ref": "#/definitions/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Create a new item",
        "description": "Creates a new item with the provided details",
        "tags": ["items"],
        "security": [{"Bearer": []}],
        "parameters": [
          {
            "name": "item",
            "in": "body",
            "description": "Item details",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateItemRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Item created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "item": {
                  "$ref": "#/definitions/Item"
                },
                "createdBy": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/items/{id}": {
      "get": {
        "summary": "Get item by ID",
        "description": "Retrieves a specific item by its ID",
        "tags": ["items"],
        "security": [{"Bearer": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Item ID",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved item",
            "schema": {
              "$ref": "#/definitions/Item"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Item not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "summary": "Update an existing item",
        "description": "Updates an item with the provided ID and details",
        "tags": ["items"],
        "security": [{"Bearer": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Item ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "item",
            "in": "body",
            "description": "Updated item details",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateItemRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item updated successfully",
            "schema": {
              "$ref": "#/definitions/Item"
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Item not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete an item",
        "description": "Deletes an item with the provided ID",
        "tags": ["items"],
        "security": [{"Bearer": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Item ID",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Item deleted successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Item not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Home page",
        "description": "Renders the application home page",
        "tags": ["frontend"],
        "responses": {
          "200": {
            "description": "Home page HTML"
          }
        }
      }
    },
    "/login": {
      "get": {
        "summary": "Login page",
        "description": "Renders the application login page",
        "tags": ["frontend"],
        "responses": {
          "200": {
            "description": "Login page HTML"
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "summary": "Dashboard page",
        "description": "Renders the application dashboard page",
        "tags": ["frontend"],
        "responses": {
          "200": {
            "description": "Dashboard page HTML"
          }
        }
      }
    }
  },
  "definitions": {
    "Item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "CreateItemRequest": {
      "type": "object",
      "required": ["name", "content"],
      "properties": {
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "UpdateItemRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "ID": {
          "type": "string"
        },
        "Email": {
          "type": "string"
        },
        "Name": {
          "type": "string"
        }
      }
    }
  }
}